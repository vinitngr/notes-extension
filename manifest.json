{
  "manifest_version": 3,
  "name": "noty",
  "version": "1.0",
  "description": "Save selected text for later viewing",
  "permissions": [
    "storage",
    "contextMenus",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon48.png",
      "48": "icon48.png",
      "128": "icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
